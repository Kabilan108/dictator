[Unit]
Description=Dictator voice typing daemon
Documentation=https://github.com/kabilan108/dictator
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/dictator daemon
Restart=on-failure
RestartSec=5
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
Environment=PULSE_RUNTIME_PATH=%t/pulse
EnvironmentFile=-%h/.config/dictator/environment
UMask=0077

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
